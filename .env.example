# Copy this file to .env (project root or backend/) and fill in your key. .env is gitignored - never commit real keys.
# The backend loads it automatically at start-up; the frontend never sees it.

# Required for AI features (Gemini chat model + embeddings). Without it the app runs in search-only mode.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# Optional overrides
# LLM_CHAT_MODEL=gemini-flash-latest
# LLM_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-lite-latest
# LLM_EMBEDDING_MODEL=gemini-embedding-001
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   # or https://openrouter.ai/api/v1 with OPENROUTER_API_KEY
# RAG_EMBEDDING_PROVIDER=auto        # auto | openrouter (remote) | local
# RAG_REINDEX_ON_STARTUP=false       # true = rebuild the vector index on every start
# SERVER_PORT=9091
